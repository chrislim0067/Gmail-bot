APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://outreach:outreach@localhost:5432/outreach
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

JWT_SECRET=CHANGE_ME_32_CHAR_MINIMUM_SECRET_KEY
JWT_EXPIRE_MINUTES=60
TOKEN_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
UNSUBSCRIBE_SECRET=CHANGE_ME_UNSUBSCRIBE_SECRET

GOOGLE_CLIENT_ID=TODO.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TODO
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/gmail/callback
GOOGLE_OAUTH_PUBLISHING_STATUS=testing
GOOGLE_OAUTH_TEST_USER_LIMIT=100

USE_MOCK_GMAIL=true

GLOBAL_DAILY_SEND_LIMIT=200
GLOBAL_RISK_SCORE_THRESHOLD=100
DEFAULT_TIER_NEW_DAILY=5
DEFAULT_TIER_NEW_HOURLY=1
DEFAULT_TIER_TRUSTED_DAILY=30
DEFAULT_TIER_TRUSTED_HARD_MAX=75

# Local dev only — do NOT set localhost on Vercel (leave unset there; auto-detects /_/backend/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Vercel: delete NEXT_PUBLIC_API_URL or set to your deployed API:
# NEXT_PUBLIC_API_URL=https://your-app.vercel.app/_/backend/api/v1
# FRONTEND_URL=https://your-app.vercel.app
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/_/backend/api/v1/gmail/callback
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
# REDIS_URL=rediss://default:token@xxx.upstash.io:6379
# APP_ENV=production
# SCHEDULER_BACKGROUND_ENABLED=false

# Wait 30 minutes between sends per Gmail account
INTER_SEND_DELAY_MIN_SECONDS=1800
INTER_SEND_DELAY_MAX_SECONDS=1800

# Wait 2-3 minutes between sends from different accounts in the same pool
INTER_ACCOUNT_DELAY_MIN_SECONDS=120
INTER_ACCOUNT_DELAY_MAX_SECONDS=180
