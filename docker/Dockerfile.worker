FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml /app/backend/
RUN pip install --no-cache-dir \
    fastapi "sqlalchemy[asyncio]" asyncpg pydantic-settings \
    "python-jose[cryptography]" httpx redis cryptography jinja2 \
    email-validator python-multipart celery bcrypt

COPY backend/app /app/backend/app
COPY workers /app/workers

ENV PYTHONPATH=/app:/app/backend
WORKDIR /app

CMD ["celery", "-A", "workers.celery_app", "worker", "-Q", "send,sync,import,health,default", "--loglevel=info"]
